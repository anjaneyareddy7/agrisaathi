# ─────────────────────────────────────────────────────────────
# AgriSaathi backend settings
# Copy this file to `.env` and fill in your keys.
# (.env is git-ignored — never commit real keys.)
# ─────────────────────────────────────────────────────────────

# Weather (OpenWeatherMap). Get a free key: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_key_here
# Only change this if you use a different weather provider
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# data.gov.in — live mandi prices, schemes & open data
DATA_GOV_API_KEY=your_datagov_key_here

# AI helpers (optional)
GEMINI_API_KEY=
GROQ_API_KEY=

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
